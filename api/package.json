{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/db/data-source.ts",
    "migration:run": "node scripts/run-env.js typeorm migration:run",
    "migration:revert": "node scripts/run-env.js typeorm migration:revert",
    "migration:fresh": "node scripts/run-env.js typeorm schema:drop && npm run migration:run",
    "import:provinces": "node scripts/run-env.js script import-provinces",
    "seed:resources": "node scripts/run-env.js script seed-resources",
    "seed:classes": "node scripts/run-env.js script seed-classes",
    "seed:goods": "node scripts/run-env.js script seed-goods",
    "seed:buildings": "node scripts/run-env.js script seed-buildings",
    "seed:techs": "node scripts/run-env.js script seed-techs",
    "seed:troop-types": "node scripts/run-env.js script seed-troop-types",
    "seed:test-countries": "node scripts/run-env.js script seed-test-countries",
    "reset:game": "node scripts/run-env.js script reset-game-data",
    "fix:neighbors": "node scripts/run-env.js script fix-province-neighbors",
    "balance:report": "ts-node --transpile-only src/scripts/balance-report.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.3.1",
    "mysql2": "^3.20.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
